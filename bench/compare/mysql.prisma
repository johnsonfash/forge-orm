// Prisma schema for the comparison bench (MySQL).
// Prisma does NOT own this schema. forge creates the physical table; we only
// run prisma generate to produce a client that queries the existing table.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/mysql"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String   @id @db.VarChar(64)
  email      String   @unique @db.VarChar(255)
  name       String   @db.VarChar(255)
  role       String   @db.VarChar(64)
  active     Boolean
  created_at DateTime @db.DateTime(3)
  updated_at DateTime @db.DateTime(3)

  @@map("users")
}
