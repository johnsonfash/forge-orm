# ─── forge — example environment variables ─────────────────────────────────
#
# Copy this file to `.env` (which is gitignored) and edit values to match
# your local databases. Every `npm run forge:*` script loads `.env` at
# startup via dotenv.
#
# All variables have sensible defaults baked into the code — `.env` only
# needs to be present when you want to override them.


# ─── Primary URL — used by forge:doctor / forge:push, and by createDb() in
#     application code. Adapter is inferred from the URL prefix.
#
#       mongodb://…       → mongo adapter
#       postgres://…      → postgres adapter
#       mysql://…         → mysql adapter (Wave 3)
#       sqlite:./db       → sqlite adapter (Wave 3)

# DATABASE_URL=mongodb://127.0.0.1:27017/myapp
# DATABASE_URL=postgres://forge:password@127.0.0.1:5432/myapp


# ─── Live integration tests — forge:integration:pg
#
# `forge:integration:pg` bootstraps a unique throwaway database
# `forge_smoke_<ts>` against the configured PG, runs 38 scenarios, then
# drops it. Defaults assume a local PG on the standard port with a user
# matching your OS login.

# SMOKE_PG_USER=johnfash
# SMOKE_PG_HOST=127.0.0.1
# SMOKE_PG_PORT=5432
# SMOKE_PG_ROOT=postgres          # bootstrap database used to CREATE / DROP


# ─── Live integration tests — forge:integration:mongo
#
# `forge:integration:mongo` connects to a unique db name and drops it on
# exit. Override the full URL if your Mongo listens elsewhere.

# SMOKE_MONGO_URL=mongodb://127.0.0.1:27017/forge_smoke


# ─── Benchmarks — forge:bench
#
# Side-by-side latency comparison (forge vs raw driver) on the configured
# adapters. Set SKIP_PG=1 or SKIP_MONGO=1 to opt out of an adapter you
# don't have running locally.

# BENCH_PG_URL=postgres://forge@127.0.0.1:5432/postgres
# BENCH_MONGO_URL=mongodb://127.0.0.1:27017
# BENCH_SEED=500                  # rows seeded into the bench table
# BENCH_ITER=200                  # iterations per scenario
# SKIP_PG=1                       # uncomment to skip Postgres
# SKIP_MONGO=1                    # uncomment to skip Mongo
